// VrindaaCorp CRM — data model
// Covers SOW 3.1 (leads/cleanup), 3.2 (outreach), 3.3 (CRM/tracking), 3.4 (notify).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OWNER
  AGENT
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  passwordHash   String
  role           Role           @default(AGENT)
  whatsappNumber String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  ownedLeads     Lead[]         @relation("LeadOwner")
  assignedTasks  Task[]         @relation("TaskAssignee")
  notifications  Notification[] @relation("NotificationOwner")
  activities     Activity[]
  notes          Note[]
}

// ---------------------------------------------------------------------------
// Leads (SOW 3.1 / 3.3)
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum ValidationStatus {
  UNKNOWN
  VALID
  INVALID
  RISKY
}

model Lead {
  id               String           @id @default(cuid())
  firstName        String?
  lastName         String?
  company          String?
  email            String
  emailNormalized  String           // lowercased/trimmed — used for dedup + suppression match
  phone            String?
  sector           String?          // canonical: B&I, Manufacturing, Healthcare, Education, ...
  city             String?          // normalized city name (e.g. Gurgaon, Lucknow)
  geography        String?          // canonical region derived from city: NCR, UP, Rajasthan, ...
  source           String?
  stage            LeadStage        @default(NEW)
  validationStatus ValidationStatus @default(UNKNOWN)
  isSuppressed     Boolean          @default(false)
  hot              Boolean          @default(false) // "Hot — Awaiting Owner Action"
  ownerId          String?
  owner            User?            @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tags             LeadTag[]
  enrollments      Enrollment[]
  emailEvents      EmailEvent[]
  activities       Activity[]
  notes            Note[]
  tasks            Task[]
  notifications    Notification[]

  @@index([emailNormalized])
  @@index([stage])
  @@index([sector])
  @@index([geography])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  kind     String    @default("general") // sector | geography | priority | campaign | general
  leads    LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// ---------------------------------------------------------------------------
// Import staging (SOW 3.1)
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  MAPPED
  PROCESSING
  COMPLETED
  FAILED
}

model ImportBatch {
  id             String        @id @default(cuid())
  filename       String
  status         ImportStatus  @default(PENDING)
  columnMapping  Json?         // { email: "Email Address", company: "Company", ... }
  totalRows      Int           @default(0)
  importedRows   Int           @default(0)
  duplicateRows  Int           @default(0)
  invalidRows    Int           @default(0)
  createdAt      DateTime      @default(now())
  rows           ImportRow[]
}

model ImportRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  raw       Json        // original row keyed by source column
  status    String      @default("pending") // pending | imported | duplicate | invalid
  note      String?

  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Campaigns & sequences (SOW 3.2)
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  segment      Json?          // filter used to enroll leads: { sector, geography, tags }
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  steps        SequenceStep[]
  enrollments  Enrollment[]
}

model EmailTemplate {
  id            String         @id @default(cuid())
  name          String
  subjectA      String
  subjectB      String?        // A/B variant (optional)
  html          String         // supports {{firstName}}, {{company}}, {{sector}}, {{unsubscribe}}
  aiEnabled     Boolean        @default(false) // generate per-lead copy with AI
  aiBrief       String?        // brief/offer the AI uses to write each personalized email
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         SequenceStep[]
}

model SequenceStep {
  id          String        @id @default(cuid())
  campaignId  String
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id])
  order       Int           // 0 = initial, 1..n = follow-ups
  delayDays   Int           // days after previous step (e.g. 0, 3, 6)

  @@unique([campaignId, order])
}

enum EnrollmentState {
  ACTIVE
  PAUSED
  COMPLETED
}

model Enrollment {
  id           String          @id @default(cuid())
  leadId       String
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  currentStep  Int             @default(0)
  state        EnrollmentState @default(ACTIVE)
  pausedReason String?         // replied | unsubscribed | bounced | manual
  nextSendAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  emailEvents  EmailEvent[]

  @@unique([leadId, campaignId])
  @@index([state, nextSendAt])
}

// ---------------------------------------------------------------------------
// Email events / tracking (SOW 3.2 / 3.3)
// ---------------------------------------------------------------------------

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

model EmailEvent {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollmentId  String?
  enrollment    Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  stepOrder     Int?
  type          EmailEventType
  messageId     String?        // SES message id, used to correlate webhook events
  subjectVariant String?       // "A" | "B"
  metadata      Json?
  createdAt     DateTime       @default(now())

  @@index([leadId])
  @@index([type])
  @@index([messageId])
  @@index([createdAt])
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  MANUAL
}

model Suppression {
  id              String            @id @default(cuid())
  emailNormalized String            @unique
  reason          SuppressionReason
  createdAt       DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// CRM activity, notes, tasks (SOW 3.3)
// ---------------------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String   // stage_change | email_sent | email_opened | reply | note | task | import
  message   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  title       String
  dueAt       DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([assigneeId, completed])
}

// ---------------------------------------------------------------------------
// Owner notifications & escalation (SOW 3.4)
// ---------------------------------------------------------------------------

enum NotificationState {
  SENT
  ACKNOWLEDGED
  ESCALATED
}

model Notification {
  id           String            @id @default(cuid())
  leadId       String
  lead         Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId      String?
  owner        User?             @relation("NotificationOwner", fields: [ownerId], references: [id])
  channels     String            // comma list: email,whatsapp
  state        NotificationState @default(SENT)
  context      String?           // reply snippet / alert context
  acknowledgedAt DateTime?
  escalatedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([state, createdAt])
}

// ---------------------------------------------------------------------------
// Background job log (sender / scheduler / escalation)
// ---------------------------------------------------------------------------

model JobRun {
  id        String   @id @default(cuid())
  job       String   // sender | scheduler | escalation
  startedAt DateTime @default(now())
  finishedAt DateTime?
  ok        Boolean  @default(false)
  detail    String?
}
