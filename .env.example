# --- Database ---
DATABASE_URL="postgresql://vrindaa:vrindaa@localhost:5432/vrindaacorp_crm?schema=public"

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
# Public base URL used to build tracking pixel / click / unsubscribe links in emails.
APP_URL="http://localhost:3000"

# --- Amazon SES (sending + tracking + inbound) ---
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET="vrindaacorp-tracking"
SES_FROM_EMAIL="outreach@vrindaacorp.example"
SES_FROM_NAME="VrindaaCorp Services"
# Shared secret required on inbound/SNS webhook calls (?token=...)
SES_WEBHOOK_SECRET="change-me"

# --- Email validation (optional bulk verifier) ---
# Leave EMAIL_VERIFIER=none to run syntax + MX checks only.
EMAIL_VERIFIER="none"           # none | neverbounce | zerobounce
EMAIL_VERIFIER_API_KEY=""

# --- AI email generation (Anthropic) ---
# When set, AI-enabled templates generate a personalized email per lead
# (name + company + sector). Leave blank to fall back to token templating.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="hot_lead_alert"

# --- Outreach sending limits ---
DAILY_SEND_CAP="1000"           # batch cap per day (SOW: 500-1000/day)
ESCALATION_HOURS="48"           # owner escalation window
