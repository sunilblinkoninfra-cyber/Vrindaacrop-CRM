# --- Database ---
DATABASE_URL="postgresql://vrindaa:vrindaa@localhost:5432/vrindaacorp_crm?schema=public"

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
# Public base URL used to build tracking pixel / click / unsubscribe links in emails.
APP_URL="http://localhost:3000"

# --- Amazon SES (sending + tracking + inbound) ---
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET="vrindaacorp-tracking"
SES_FROM_EMAIL="outreach@vrindaacorp.example"
SES_FROM_NAME="VrindaaCorp Services"
# Shared secret required on inbound/SNS webhook calls (?token=...)
SES_WEBHOOK_SECRET="change-me"

# --- Email validation (optional bulk verifier) ---
# Leave EMAIL_VERIFIER=none to run syntax + MX checks only.
EMAIL_VERIFIER="none"           # none | neverbounce | zerobounce
EMAIL_VERIFIER_API_KEY=""

# --- AI (email generation + contract intelligence) ---
# Provider: "anthropic" (hosted) or "local" (OpenAI-compatible model on your server).
AI_PROVIDER="anthropic"
# For AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
# For AI_PROVIDER=local (Ollama / vLLM / LM Studio, shared by website + CRM):
LOCAL_AI_BASE_URL=""             # e.g. http://localhost:11434/v1
LOCAL_AI_MODEL=""                # e.g. llama3.1:8b-instruct

# --- Web search (optional, grounds contract intelligence) ---
WEBSEARCH_PROVIDER="none"        # none | serper | searxng
WEBSEARCH_API_KEY=""             # for serper
WEBSEARCH_BASE_URL=""            # for self-hosted searxng, e.g. http://localhost:8080

# --- Inbound lead capture (website form / Meta / Google Ads) ---
INBOUND_FORM_SECRET="change-me"  # website form shared secret (X-Form-Secret / ?token=)
META_VERIFY_TOKEN=""             # Meta webhook verify token
META_APP_SECRET=""               # Meta app secret (verifies X-Hub-Signature-256)
META_PAGE_TOKEN=""               # Page access token (Graph API lead fetch)
GOOGLE_LEAD_KEY=""               # Google Ads Lead Form webhook key

# --- Company unattended alerts ---
COMPANY_ALERT_EMAIL=""           # shared inbox for 24h unattended-lead reminders
UNATTENDED_HOURS="24"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="hot_lead_alert"

# --- Outreach sending limits ---
# Emergency hard ceiling; the database-backed SendingPlan is the primary cap.
DAILY_SEND_CAP="1000"
# Maximum messages claimed by one cron/worker invocation.
SCHEDULER_MAX_PER_RUN="25"
# Sender tick cadence for the long-running worker; Vercel uses vercel.json.
SCHEDULER_INTERVAL_MINUTES="5"
SEND_TIMEZONE="Asia/Kolkata"
SEND_WINDOW_START="09:00"
SEND_WINDOW_END="18:00"
ESCALATION_HOURS="48"           # owner escalation window
